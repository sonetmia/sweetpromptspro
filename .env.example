# PostgreSQL database used by the custom authentication system
DATABASE_URL=

# Super Admin credentials. ADMIN_PASSWORD_HASH must be a scrypt hash generated from the admin password.
ADMIN_WHATSAPP=
ADMIN_PASSWORD_HASH=

# Exact public origin, for example https://your-domain.com
APP_ORIGIN=

# Server-side OpenAI-compatible AI gateway configuration. Never expose or commit real credentials.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
