# SweetPrompts Pro - Environment Configuration Example
# Copy to .env.local for local development, or configure in Vercel Project Settings.
# Note: SweetPrompts Pro also supports direct in-app API key configuration in Settings,
# which stores your personal key safely in your browser localStorage.

# Google Gemini API Key (Recommended for Adobe Stock Prompt Engine & Vision Analysis)
VITE_GEMINI_API_KEY=

# Groq Cloud API Key (Ultra-Fast 400+ tok/s LPU Inference)
VITE_GROQ_API_KEY=

# Mistral AI API Key
VITE_MISTRAL_API_KEY=

# OpenRouter API Key (Claude 3.5, GPT-4o, DeepSeek)
VITE_OPENROUTER_API_KEY=

# Hugging Face Inference API Token
VITE_HUGGINGFACE_API_KEY=

# Cerebras Cloud API Key (1,500+ tok/s Inference)
VITE_CEREBRAS_API_KEY=
